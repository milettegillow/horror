# Copy to .env and fill in. .env is git-ignored and never reaches the browser.

# Upstash Redis, for the collection. Both from the Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The PIN that unlocks editing. Any string; it is compared server-side only.
EDIT_PIN=

# TMDB, for posters and Discover. https://www.themoviedb.org/settings/api
TMDB_KEY=
